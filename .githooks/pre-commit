#!/bin/bash

# Pre-commit hook for spring-core project
# - Prevents commits with obvious issues
# - Validates basic code quality

echo "Running pre-commit checks..."

# 1. Check for merge conflict markers
if git diff --cached --name-only | xargs grep -l "^<<<<<<< \|^======= \|^>>>>>>> " 2>/dev/null; then
  echo "Merge conflict markers found. Please resolve conflicts before committing."
  exit 1
fi

# 2. Check for TODO/FIXME in staged files
TODOS=$(git diff --cached --name-only | grep '\.java$' | xargs grep -n "TODO\|FIXME" 2>/dev/null || true)
if [ -n "$TODOS" ]; then
  echo "Warning: TODO/FIXME comments found:"
  echo "$TODOS"
  echo ""
  echo "Consider addressing these before committing, or proceed if intentional."
  read -p "Continue? (y/n) " -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    exit 1
  fi
fi

# 3. Check for debugging statements
DEBUG_PATTERNS="System\.out\.println|printStackTrace\(\)"
DEBUG_FOUND=$(git diff --cached --name-only | grep '\.java$' | xargs grep -nE "$DEBUG_PATTERNS" 2>/dev/null || true)
if [ -n "$DEBUG_FOUND" ]; then
  echo "Warning: Debugging statements found:"
  echo "$DEBUG_FOUND"
  echo ""
  read -p "Continue? (y/n) " -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    exit 1
  fi
fi

# 4. Check for large files (> 1MB)
LARGE_FILES=$(git diff --cached --name-only | while read file; do
  if [ -f "$file" ]; then
    size=$(wc -c < "$file")
    if [ "$size" -gt 1048576 ]; then
      echo "$file ($(($size / 1048576))MB)"
    fi
  fi
done)

if [ -n "$LARGE_FILES" ]; then
  echo "Warning: Large files detected:"
  echo "$LARGE_FILES"
  echo ""
  read -p "Continue? (y/n) " -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    exit 1
  fi
fi

# 5. Check for potential secrets (basic patterns)
SECRETS=$(git diff --cached --name-only | grep -E '\.(java|properties|yml|yaml)$' | xargs grep -iE "(password|secret|api[_-]?key|token).*=.*['\"][^'\"]{20,}['\"]" 2>/dev/null || true)
if [ -n "$SECRETS" ]; then
  echo "Potential secrets detected in staged files:"
  echo "$SECRETS"
  echo ""
  echo "Please remove secrets and use environment variables or configuration files."
  exit 1
fi

echo "Pre-commit checks passed"
exit 0