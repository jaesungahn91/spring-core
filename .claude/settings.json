{
  "model": "claude-sonnet-4-5-20250929",
  "alwaysThinkingEnabled": true,

  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(gradle build:*)",
      "Bash(gradle test:*)",
      "Bash(./gradlew:*)",
      "Read(src/**)",
      "Read(.github/**)",
      "Read(*.md)",
      "Read(*.gradle)",
      "Read(*.properties)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh:*)",
      "Edit(*.java)",
      "Write(*.java)",
      "Edit(*.md)",
      "Write(*.md)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      "Read(application-secret.properties)",
      "Edit(.git/config)",
      "Write(.env*)"
    ],
    "additionalDirectories": [],
    "defaultMode": "default"
  },

  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/user-prompt-submit-hook.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/validate-bash.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-secrets.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/format-java.sh",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/session-start.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  },


  "sandbox": {
    "enabled": false,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["docker", "kubectl"],
    "network": {
      "allowLocalBinding": true
    }
  },

  "attribution": {
    "commit": "",
    "pr": ""
  },

  "companyAnnouncements": [
    "Spring Boot 멀티 모듈 레퍼런스 프로젝트입니다",
    "Issue-Driven Workflow: 모든 작업은 Issue 번호(#123) 포함 필수",
    "작업 후 허가 없이 커밋 금지",
    "코드 리뷰 가이드: .claude/rules/ 참고"
  ],

  "outputStyle": "Default",

  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": ["github", "memory", "filesystem"],
  "disabledMcpjsonServers": [],

  "disableAllHooks": false,
  "allowManagedHooksOnly": false
}
